; 仅用于无图形上游组件测试，不是可玩游戏。
config_version=5

[application]
config/name="Ruleweaver Native Validation"
config/use_custom_user_dir=true
config/custom_user_dir_name="RuleweaverNativeValidation"
config/features=PackedStringArray("4.6", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
