extends SceneTree
## 玩家词条的编辑/封装必须复用正式运行器，不用另一套程序解释器证明自己。
const Document=preload("res://presentation/loom_document.gd")
const World=preload("res://runtime/world_session.gd")
const Runtime=preload("res://runtime/rule_runtime.gd")
var passed:int=0
var failed:int=0
func check(value:bool,label:String)->void:
	if value:passed+=1;print("PASS: ",label)
	else:failed+=1;printerr("FAIL: ",label)
func _initialize()->void:call_deferred("_run")
func finish()->void:
	print("WORD_COMPOSITION_TEST_RESULT: ",passed," passed; ",failed," failed");quit(0 if failed==0 else 1)
func fixture()->Dictionary:
	var catalog:Dictionary={"format":"rw.catalog/0.1","materials":{"core:stone":{"stackable":true},"user:reservoir":{"stackable":false,"state":"reservoir/0.1"}},"rules":{}}
	var w=World.new(catalog)
	var state:Dictionary={"format":"rw.world/0.2","actor":{"id":"player:local","cell":[1,-2]},"terrain":[{"cell":[1,1],"material_id":"core:stone"}],"water":[{"cell":[1,0],"units":1000}],"entities":{"format":"rw.instances/0.1","world_id":"world:words","stacks":{},"instances":[]}}
	for spec in [["creation:a",0],["creation:b",2]]:
		state.entities.instances.append({"id":spec[0],"material_id":"user:reservoir","rules":[],"state":{"water_units":0,"capacity_units":1000,"light_on":false},"location":{"kind":"world","cell":[spec[1],0]}})
	check(w.load_checkpoint(JSON.stringify(state)).ok,"fixture_world")
	return {"w":w,"r":Runtime.new(catalog,w),"catalog":catalog,"initial":state}
func atomic(d, action:Callable,label:String)->void:
	var before:Dictionary=d.snapshot();var history:int=d._undo.size()
	var r:Dictionary=action.call()
	check(not r.ok and d.snapshot()==before and d._undo.size()==history,label)
func _run()->void:
	var d=Document.new();d.start("user:draft");d.preset("pump",100)
	check(d.has_method("expose_constant"),"parameterized_word_editing_exists")
	if not d.has_method("expose_constant"):finish();return
	var original:Dictionary=d.snapshot()
	check(d.expose_constant("rate","rate").ok,"constant_exposed")
	check(d.node("rate").op=="param" and d.node("rate").config=={"name":"rate"},"node_identity_preserves_wires")
	check(d.snapshot().parameters=={"rate":{"type":"int","default":100}},"typed_default_recorded")
	check(d.node("limited").inputs.a=="rate","downstream_wires_preserved")
	check(d.undo().ok and d.snapshot()==original,"expose_single_undo")
	check(d.redo().ok and d.node("rate").op=="param","expose_redo")
	atomic(d,func():return d.expose_constant("zero","rate"),"duplicate_parameter_rejected_without_merging")
	atomic(d,func():return d.expose_constant("zero","when"),"reserved_parameter_rejected")
	atomic(d,func():return d.expose_constant("zero","bad name"),"invalid_parameter_name_rejected")
	atomic(d,func():return d.expose_constant("water","other"),"query_cannot_be_exposed_as_constant")
	atomic(d,func():return d.expose_constant("missing","x"),"missing_constant_rejected")
	atomic(d,func():return d.set_parameter_default("rate",true),"int_bool_mismatch_rejected")
	atomic(d,func():return d.set_parameter_default("rate",1.5),"float_parameter_rejected")
	atomic(d,func():return d.set_parameter_default("rate",Document.Codec.MAX_QUANTITY+1),"excessive_parameter_rejected")
	atomic(d,func():return d.set_parameter_default("unknown",1),"missing_parameter_rejected")
	check(d.set_parameter_default("rate",150).ok,"change_default")
	check(d.internalize_parameter("rate").ok and d.node("rate").op=="int" and d.node("rate").config.value==150 and d.snapshot().parameters.is_empty(),"restore_constant_explicitly")
	check(d.undo().ok and d.snapshot().parameters.rate.default==150,"restore_parameter_undo")
	var f:Dictionary=fixture();var w=f.w;var r=f.r
	var live:String=w.checkpoint_json();var graph:Dictionary=d.snapshot();var history:int=d._undo.size()
	var published:Dictionary=d.publish_word(r,"user:water_pump")
	check(published.ok,"publish_parameterized_word")
	if not published.ok:finish();return
	check(published.entry=={"id":"user:water_pump","version":1},"word_reference_versioned")
	check(w.checkpoint_json()==live and d.snapshot()==graph and d._undo.size()==history,"library_publication_does_not_bind_or_edit_draft")
	var oldpack:String=r.pack_json()
	check(not d.publish_word(r,"core:forbidden").ok and r.pack_json()==oldpack,"reserved_publication_atomic")
	d.disconnect_port("take","amount")
	check(not d.publish_word(r,"user:broken").ok and r.pack_json()==oldpack,"invalid_word_not_published")
	d.undo()
	var lamp=Document.new();lamp.start("user:lamp_draft");lamp.preset("lamp")
	check(lamp.expose_constant("always","enabled").ok,"boolean_exposed")
	check(lamp.set_parameter_default("enabled",false).ok and lamp.set_parameter_default("enabled",true).ok,"boolean_default_editable")
	check(lamp.publish_word(r,"user:dark_lamp").ok,"second_word_published")
	var composite=Document.new();composite.start("user:smart_carrier");composite.preset("blank")
	var call:Dictionary=composite.append_word(r,"user:water_pump",1)
	check(call.ok,"append_pump_word")
	if not call.ok:finish();return
	var rate_id:String=composite.node(call.id).inputs.rate
	check(composite.node(rate_id).config.value==150,"append_uses_declared_default")
	check(composite.expose_constant(rate_id,"rate").ok,"nested_word_can_expose_call_argument")
	check(composite.append_word(r,"user:dark_lamp",1).ok and composite.validate(r).ok,"two_words_combine_without_custom_primitive")
	check(composite.publish_word(r,"user:smart_carrier").ok,"composite_word_published")
	var a=Document.new();a.start("user:actor_a");a.preset("blank")
	var ac:Dictionary=a.append_word(r,"user:smart_carrier",1)
	var b=Document.new();b.start("user:actor_b");b.preset("blank")
	var bc:Dictionary=b.append_word(r,"user:smart_carrier",1)
	check(ac.ok and bc.ok,"same_nested_word_two_callers")
	a.change_config(a.node(ac.id).inputs.rate,{"value":100});b.change_config(b.node(bc.id).inputs.rate,{"value":200})
	var ca:Dictionary=a.candidate(r);var cb:Dictionary=b.candidate(r)
	check(r.publish_pack(ca.text,{"creation:a":[{"id":ca.module.id,"version":ca.module.version}]}).ok,"bind_first_caller")
	check(r.publish_pack(cb.text,{"creation:b":[{"id":cb.module.id,"version":cb.module.version}]}).ok,"bind_second_caller")
	check(r.advance(true).ok,"nested_programs_execute")
	check(w.get_instance("creation:a").state.water_units==100 and w.get_instance("creation:b").state.water_units==200 and w.water_at(Vector2i(1,0))==700,"typed_parameters_produce_distinct_real_water_transfer")
	check(w.get_instance("creation:a").state.light_on and w.get_instance("creation:b").state.light_on,"combined_light_action_runs")
	check(w.total_water_units()==1000,"composition_conserves_water")
	var v1:Dictionary=r.rule_definition("user:water_pump",1)
	d.set_parameter_default("rate",50)
	check(d.publish_word(r,"user:water_pump").entry.version==2,"new_word_version")
	check(r.rule_definition("user:water_pump",1)==v1 and composite.node(call.id).config.version==1,"existing_dependencies_remain_pinned")
	check(r.advance(true).ok and w.get_instance("creation:a").state.water_units==200 and w.get_instance("creation:b").state.water_units==400,"new_version_does_not_change_old_callers")
	var scroll:Dictionary=r.export_rule("user:actor_a",1)
	check(scroll.ok,"export_nested_word")
	var payload:Dictionary=JSON.parse_string(scroll.text)
	check(payload.rules.modules.size()==4,"export_contains_only_transitive_dependency_closure")
	var fresh:Dictionary=fixture();var r2=fresh.r;var w2=fresh.w
	check(r2.import_scroll(scroll.text).ok and w2.get_instance("creation:a").rules.is_empty(),"cross_world_import_has_no_implicit_binding")
	check(r2.bind_rules("creation:a",[{"id":"user:actor_a","version":1}]).ok and r2.advance(true).ok,"imported_nested_word_runs")
	check(w2.get_instance("creation:a").state.water_units==100 and w2.get_instance("creation:a").state.light_on,"imported_semantics_match")
	var save:String=r.checkpoint_json();var restore:Dictionary=fixture()
	check(restore.r.load_checkpoint(save).ok and restore.r.checkpoint_json()==save,"published_library_roundtrip")
	check(restore.r.advance(true).ok and restore.w.get_instance("creation:a").state.water_units==300,"restored_nested_program_continues")
	atomic(a,func():return a.append_word(r,"user:missing",1),"missing_word_append_atomic")
	atomic(a,func():return a.append_word(r,"user:water_pump",99),"missing_version_append_atomic")
	# 改目标只保留仍存在且同类型的参数连线；绝不带入旧签名错误端口。
	check(a.change_call_target(r,ac.id,"user:dark_lamp",1).ok,"change_call_target")
	check(not a.node(ac.id).inputs.has("rate") and a.node(ac.id).inputs.has("when") and a.validate(r).ok,"obsolete_argument_removed_keep_condition")
	check(a.undo().ok and a.node(ac.id).config.id=="user:smart_carrier","call_change_single_undo")
	atomic(a,func():return a.change_call_target(r,ac.id,"user:missing",1),"bad_call_change_atomic")
	check(d.has_method("edit_word"),"word_copy_editing_exists")
	if not d.has_method("edit_word"):finish();return
	var before_edit:Dictionary=d.snapshot();var pack_before_edit:String=r.pack_json()
	check(d.edit_word(r,"user:dark_lamp",1).ok and d.snapshot().id=="user:dark_lamp","load_library_word_as_editable_copy")
	check(d.undo().ok and d.snapshot()==before_edit and r.pack_json()==pack_before_edit,"edit_copy_undo_does_not_change_library")
	atomic(d,func():return d.edit_word(r,"user:missing",1),"missing_copy_atomic")
	var bounded=Document.new();bounded.start("user:bounded");bounded.preset("blank")
	for i in 9:
		var n:Dictionary=bounded.add("int",{"value":i})
		if i<8:check(bounded.expose_constant(n.id,"p"+str(i)).ok,"parameter_budget_slot_%d"%i)
		else:atomic(bounded,func():return bounded.expose_constant(n.id,"p8"),"parameter_budget_atomic")
	var full=Document.new();full.start("user:full");full.preset("lamp")
	while full.snapshot().nodes.size()<63:full.add("int",{"value":1})
	atomic(full,func():return full.append_word(r,"user:water_pump",1),"append_node_budget_atomic")
	var effects=Document.new();effects.start("user:effects");effects.preset("blank")
	for i in 16:effects.add("move",{"dx":1,"dy":0})
	atomic(effects,func():return effects.append_word(r,"user:dark_lamp",1),"append_effect_budget_atomic")
	var out:String=OS.get_environment("RULEWEAVER_NATIVE_COMPOSITION")
	if not out.is_empty():
		var file:=FileAccess.open(out,FileAccess.WRITE)
		check(file!=null,"composition_evidence_open")
		if file!=null:file.store_string(JSON.stringify(load("res://presentation/workspace_checkpoint.gd").integer_tree({"format":"rw.composition_evidence/0.1","simulation":JSON.parse_string(save),"scroll":payload,"imported":JSON.parse_string(r2.checkpoint_json())})));file.close()
	finish()
